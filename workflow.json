{
  "id": "JDResumeFit00001",
  "name": "JD-Resume Fit Analyzer",
  "nodes": [
    {
      "parameters": {
        "formTitle": "JD-Resume Fit Analyzer",
        "formDescription": "Upload a job description PDF and a candidate resume PDF. The workflow returns a structured fit analysis and a recommended next action.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job Description",
              "fieldType": "file",
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Resume",
              "fieldType": "file",
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Candidate Email",
              "fieldType": "email",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "node-form-trigger",
      "name": "Form: Submit JD + Resume",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "jd-resume-fit-analyzer-webhook"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "Job_Description",
        "options": { "keepSource": "json" }
      },
      "id": "node-extract-jd",
      "name": "Extract JD Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "Resume",
        "options": { "keepSource": "json" }
      },
      "id": "node-extract-resume",
      "name": "Extract Resume Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "// DETERMINISTIC STEP: pull the extracted PDF text and validate it.\n// 'Extract JD Text' and 'Extract Resume Text' each put their PDF text into json.text;\n// we read each via its node reference. This is a fallback guard so we never waste an AI call on empty/garbage input.\nconst jd = ($('Extract JD Text').first().json.text || '').trim();\nconst resume = ($('Extract Resume Text').first().json.text || '').trim();\nconst email = ($input.first().json['Candidate Email'] || '').trim();\nconst isValid = jd.length > 30 && resume.length > 30;\nreturn [{ json: { jobDescription: jd, resume: resume, candidateEmail: email, isValid: isValid } }];"
      },
      "id": "node-validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-isvalid",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-valid",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert technical recruiter. Analyze how well the candidate's resume matches the job description. Base everything ONLY on the text provided.\n\nJOB DESCRIPTION:\n{{ $json.jobDescription }}\n\nRESUME:\n{{ $json.resume }}\n\nDo the following:\n1. Extract the key skills the job requires.\n2. List which required skills the candidate HAS (matched_skills) and which are MISSING (missing_skills).\n3. Estimate the candidate's relevant years_experience as a number.\n4. Give an overall fit_score from 0 to 100 reflecting how well the candidate matches the role.\n5. Write a 2-3 sentence summary, plus short lists of strengths and concerns.\n\nBe objective and concise.",
        "hasOutputParser": true
      },
      "id": "node-ai-analysis",
      "name": "AI: Analyze Fit",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [680, 200]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "node-gemini",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [620, 420]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"fit_score\": 82,\n  \"matched_skills\": [\"Python\", \"SQL\", \"REST APIs\"],\n  \"missing_skills\": [\"Kubernetes\"],\n  \"years_experience\": 4,\n  \"summary\": \"Strong backend engineer with relevant API and database experience.\",\n  \"strengths\": [\"Solid Python and SQL background\", \"Shipped production APIs\"],\n  \"concerns\": [\"No container orchestration experience\"]\n}",
        "autoFix": true
      },
      "id": "node-output-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [820, 420]
    },
    {
      "parameters": {
        "jsCode": "// DETERMINISTIC STEP: turn the AI's numeric fit_score into a routing decision.\n// Thresholds (not the AI) decide the category and the recommended action.\nconst ai = $input.first().json.output || $input.first().json;\nconst v = $('Validate Input').first().json;\nconst score = Math.max(0, Math.min(100, Number(ai.fit_score) || 0));\nlet category;\nlet action;\nif (score >= 75) { category = 'Strong Fit'; action = 'Auto-draft interview invitation'; }\nelse if (score >= 50) { category = 'Maybe Fit'; action = 'Flag for human review'; }\nelse { category = 'Weak Fit'; action = 'Draft polite rejection'; }\nreturn [{ json: {\n  candidateEmail: v.candidateEmail,\n  fit_score: score,\n  category: category,\n  recommended_action: action,\n  matched_skills: ai.matched_skills || [],\n  missing_skills: ai.missing_skills || [],\n  years_experience: ai.years_experience || null,\n  summary: ai.summary || '',\n  strengths: ai.strengths || [],\n  concerns: ai.concerns || []\n} }];"
      },
      "id": "node-compute-decision",
      "name": "Compute Decision (Thresholds)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 200]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-strong",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Strong Fit",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Strong Fit"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-maybe",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Maybe Fit",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Maybe Fit"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r-weak",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "Weak Fit",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Weak Fit"
            }
          ]
        },
        "options": {}
      },
      "id": "node-switch",
      "name": "Route by Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "decision", "value": "={{ $json.category }} ({{ $json.fit_score }}/100)", "type": "string" },
            { "id": "s2", "name": "next_step", "value": "Send interview invitation email", "type": "string" },
            { "id": "s3", "name": "email_subject", "value": "Interview Invitation", "type": "string" },
            { "id": "s4", "name": "email_body", "value": "=Hi,\n\nThank you for applying. Based on your background, we'd love to invite you to an interview.\n\nWhy you're a strong match: {{ $json.summary }}\n\nWe'll reach out shortly to schedule a time.\n\nBest regards,\nRecruiting Team", "type": "string" },
            { "id": "s5", "name": "matched_skills", "value": "={{ $json.matched_skills }}", "type": "array" },
            { "id": "s6", "name": "missing_skills", "value": "={{ $json.missing_skills }}", "type": "array" }
          ]
        },
        "options": {}
      },
      "id": "node-strong",
      "name": "Strong Fit → Interview Draft",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1380, 60]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1", "name": "decision", "value": "={{ $json.category }} ({{ $json.fit_score }}/100)", "type": "string" },
            { "id": "m2", "name": "next_step", "value": "HUMAN-IN-THE-LOOP: send to hiring manager for manual review", "type": "string" },
            { "id": "m3", "name": "review_reason", "value": "=Borderline score. Strengths: {{ $json.strengths.join('; ') }}. Concerns: {{ $json.concerns.join('; ') }}.", "type": "string" },
            { "id": "m4", "name": "missing_skills", "value": "={{ $json.missing_skills }}", "type": "array" }
          ]
        },
        "options": {}
      },
      "id": "node-maybe",
      "name": "Maybe Fit → Human Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1380, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "w1", "name": "decision", "value": "={{ $json.category }} ({{ $json.fit_score }}/100)", "type": "string" },
            { "id": "w2", "name": "next_step", "value": "Send polite rejection email", "type": "string" },
            { "id": "w3", "name": "email_subject", "value": "Application Update", "type": "string" },
            { "id": "w4", "name": "email_body", "value": "=Hi,\n\nThank you for your interest and for taking the time to apply. After careful review, we won't be moving forward at this time.\n\nKey gaps for this role: {{ $json.missing_skills.join(', ') }}.\n\nWe encourage you to apply for future roles that match your experience.\n\nBest regards,\nRecruiting Team", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "node-weak",
      "name": "Weak Fit → Rejection Draft",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1380, 420]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "status", "value": "rejected", "type": "string" },
            { "id": "e2", "name": "error", "value": "Invalid input: Job Description and Resume must each be at least 30 characters. Please resubmit the form.", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "node-input-error",
      "name": "Fallback: Invalid Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 460]
    }
  ],
  "connections": {
    "Form: Submit JD + Resume": {
      "main": [
        [ { "node": "Extract JD Text", "type": "main", "index": 0 } ]
      ]
    },
