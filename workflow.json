      ]
    },
    "Validate Input": {
      "main": [
        [ { "node": "Input Valid?", "type": "main", "index": 0 } ]
      ]
    },
    "Input Valid?": {
      "main": [
        [ { "node": "AI: Analyze Fit", "type": "main", "index": 0 } ],
        [ { "node": "Fallback: Invalid Input", "type": "main", "index": 0 } ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          { "node": "AI: Analyze Fit", "type": "ai_languageModel", "index": 0 },
          { "node": "Structured Output Parser", "type": "ai_languageModel", "index": 0 }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [ { "node": "AI: Analyze Fit", "type": "ai_outputParser", "index": 0 } ]
      ]
    },
    "AI: Analyze Fit": {
      "main": [
        [ { "node": "Compute Decision (Thresholds)", "type": "main", "index": 0 } ]
      ]
    },
    "Compute Decision (Thresholds)": {
      "main": [
        [ { "node": "Route by Category", "type": "main", "index": 0 } ]
      ]
    },
    "Route by Category": {
      "main": [
        [ { "node": "Strong Fit → Interview Draft", "type": "main", "index": 0 } ],
        [ { "node": "Maybe Fit → Human Review", "type": "main", "index": 0 } ],
        [ { "node": "Weak Fit → Rejection Draft", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": {
